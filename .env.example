# ─────────────────────────────────────────────────────────────
# 한국환경공단 전기차 충전소 충전건별 충전량 합성데이터 조회서비스
# https://www.data.go.kr  (엔드포인트: B552584/elcarChrsChargRcngSyrdt)
# ─────────────────────────────────────────────────────────────

# data.go.kr 에서 발급받은 인증키(serviceKey).
# "Encoding"(URL 인코딩된) 키를 그대로 붙여넣으세요.
EV_API_SERVICE_KEY=

# (선택) 엔드포인트 베이스 URL. 기본값을 그대로 쓰면 됩니다.
EV_API_BASE_URL=https://apis.data.go.kr/B552584/elcarChrsChargRcngSyrdt/getList

# (선택) 대시보드가 집계에 사용할 최대 페이지 수 (page당 100건).
# 값이 클수록 더 많은 데이터를 집계하지만 API 호출/시간이 늘어납니다.
EV_API_MAX_PAGES=20

# (선택) "1" 로 설정하면 인증키가 있어도 항상 목업(가짜) 데이터를 사용합니다.
# 인증키가 비어 있으면 이 값과 무관하게 자동으로 목업 데이터를 사용합니다.
USE_MOCK=
